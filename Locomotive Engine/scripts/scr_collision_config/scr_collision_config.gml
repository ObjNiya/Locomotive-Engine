// This array should contain every solid object in your game

global.colliders = [obj_solid, obj_slope];

// Physics defaults configuration

#macro DEFAULT_GRAVITY 0.5

#macro DEFAULT_MIN_HSP -20
#macro DEFAULT_MAX_HSP 20 

#macro DEFAULT_MIN_VSP -infinity
#macro DEFAULT_MAX_VSP 20

// Collision configurations

#macro TILE_SIZE 32