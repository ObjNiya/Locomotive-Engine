switch (global.rank)
{
    case RANKS.L:
        sprite_index = spr_l_rank_damian;
        break;
    
    case RANKS.S:
        sprite_index = spr_s_rank_damian;
        break;
    
    case RANKS.A:
        sprite_index = spr_a_rank_damian;
        break;
    
    case RANKS.B:
        sprite_index = spr_b_rank_damian;
        break;
    
    case RANKS.C:
        sprite_index = spr_c_rank_damian;
        break;
}