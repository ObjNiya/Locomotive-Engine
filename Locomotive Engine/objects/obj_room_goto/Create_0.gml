SINGLETON;

// Spawn alignment enums

enum SPAWN_XALIGN
{
    LEFT = 0,
    CENTER = 2,
    RIGHT = 1,
}

enum SPAWN_YALIGN
{
    TOP = 0,
    MIDDLE = 2,
    BOTTOM = 1,
}

// User properties

target_room = -1;
target_spawn = noone;

spawn_xalign = SPAWN_XALIGN.CENTER;
spawn_yalign = SPAWN_YALIGN.BOTTOM;

spawn_xoffset = 0;
spawn_yoffset = 0;